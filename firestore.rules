rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Who is an admin -------------------------------------------------
    // Signed in with one of these verified Google/email accounts, OR has a
    // document admins/{uid} (create it in the Firebase console to add people).
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.email_verified == true && request.auth.token.email in [
          'franckjoshuambogne@gmail.com',
          'fngoueyoumbongne@gmail.com',
          'theblutailor@gmail.com'
        ])
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function str(v, max) { return v is string && v.size() <= max; }
    function optStr(d, k, max) { return !(k in d) || str(d[k], max); }

    // ---- Consultation requests (public form) ------------------------------
    function validConsultation(d) {
      return d.keys().hasOnly(['name','email','phone','company','website','interests','engagement','adSpend','message','date','time','timezone','channel','lang','page','status','createdAt'])
        && str(d.name, 100) && d.name.size() >= 2
        && str(d.email, 160) && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && d.interests is list && d.interests.size() >= 1 && d.interests.size() <= 10
        && str(d.message, 2000) && d.message.size() >= 10
        && str(d.date, 20) && str(d.time, 40)
        && d.lang in ['en', 'fr']
        && d.status == 'new'
        && d.createdAt == request.time
        && optStr(d, 'phone', 30) && optStr(d, 'company', 120) && optStr(d, 'website', 200)
        && optStr(d, 'engagement', 80) && optStr(d, 'adSpend', 60) && optStr(d, 'timezone', 60)
        && optStr(d, 'channel', 40) && optStr(d, 'page', 200);
    }

    match /consultations/{id} {
      allow create: if validConsultation(request.resource.data);
      allow read, delete: if isAdmin();
      // Admin can only change the follow-up fields.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'updatedAt'])
        && request.resource.data.status in ['new', 'contacted', 'booked', 'done', 'spam'];
    }

    // ---- Portfolio content (edited in /admin, read by the website) --------
    match /content/{section} {
      allow read: if true;
      allow write: if isAdmin()
        && section in ['settings', 'profile', 'faqs', 'projects', 'experience', 'services', 'industries', 'credentials'];
    }

    // Uploaded images (stored as compressed data URLs).
    match /media/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
