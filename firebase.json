{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "franckpros",
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/contact",
        "destination": "/book",
        "type": 301
      },
      {
        "source": "/fr/contact",
        "destination": "/fr/book",
        "type": 301
      },
      {
        "source": "/portfolio",
        "destination": "/work",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/media/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/app.html"
      },
      {
        "source": "/admin/**",
        "destination": "/app.html"
      },
      {
        "source": "/work/**",
        "destination": "/app.html"
      },
      {
        "source": "/fr/work/**",
        "destination": "/app.html"
      },
      {
        "source": "/services/**",
        "destination": "/app.html"
      },
      {
        "source": "/fr/services/**",
        "destination": "/app.html"
      }
    ]
  }
}
