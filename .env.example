# Copy to .env and fill in. Never commit .env.
# Your live URL (or custom domain later)
VITE_SITE_URL=https://franckjoshua-portfolio.web.app

# Firebase web config — Firebase console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: also send consultation requests to Zapier / Make / a CRM
VITE_LEAD_WEBHOOK_URL=
